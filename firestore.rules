rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // ---------------------------------------------------------------------
    // Shared workspace collections
    //
    // These are the same top-level collections the Flutter app reads. Records
    // created before the web app existed do not have an `ownerId`, so access is
    // limited to authenticated members of this Firebase project instead of a
    // per-owner filter. `firestore.owner-scoped.rules` contains the stricter
    // opt-in version; read README.md before switching to it.
    // ---------------------------------------------------------------------
    match /properties/{propertyId} {
      allow read, write: if signedIn();
    }

    match /clients/{clientId} {
      allow read, write: if signedIn();
    }

    // ---------------------------------------------------------------------
    // Per-user tree
    // ---------------------------------------------------------------------
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /media/{mediaId} {
        allow read, write: if isOwner(userId);
      }

      // Account metadata may be read by its owner. Tokens must be written and
      // refreshed by a trusted server using the Admin SDK, which bypasses these
      // rules. The browser never receives a platform token.
      match /socialAccounts/{accountId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /socialPosts/{postId} {
        allow read, write: if isOwner(userId);

        // Per-destination publication results are written only by the
        // background publisher (Admin SDK). Clients may read their own results.
        match /results/{resultId} {
          allow read: if isOwner(userId);
          allow write: if false;
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
