# ---------------------------------------------------------------------------
# Firebase client configuration (safe to expose in the browser).
# Copy this file to `.env.local` and fill in the values from
# Firebase console -> Project settings -> Your apps -> Web app.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public origin used for metadata, Open Graph and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional: device preview switcher in production builds.
# The switcher is always available during `next dev`.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_DEVICE_PREVIEW=false

# ---------------------------------------------------------------------------
# Optional: AI image generation. Server-side only — never prefix with
# NEXT_PUBLIC_. Without a key the AI Image Studio shows a configuration
# state instead of pretending to generate images.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# Default in code: gemini-2.5-flash-image
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ---------------------------------------------------------------------------
# Optional: social publishing worker. Nothing publishes without real platform
# apps, OAuth callbacks, encrypted token storage, a background worker and
# Cloud Scheduler. This key is reserved for that worker; it is not used by the
# web app today.
# ---------------------------------------------------------------------------
SOCIAL_TOKEN_ENCRYPTION_KEY=
